{
    "extends": "../../tsconfig.settings.json",
    "compilerOptions": {
        "outDir": "./tsc-out",
        "rootDir": "./src",
        "forceConsistentCasingInFileNames": true,
        "lib": ["ES2020", "DOM"],
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules", "tsc-out", "dist"],
    "references": [
        {
            "path": "../contracts"
        },
        {
            "path": "../js-sdk"
        }
    ]
}
