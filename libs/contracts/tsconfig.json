{
    "extends": "../../tsconfig.settings.json",
    "compilerOptions": {
        "outDir": "./tsc-out",
        "rootDir": "./src",
        "forceConsistentCasingInFileNames": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules", "tsc-out", "dist"]
}
